# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略
# !!! 严禁把任何 *_API_KEY 写进 config.yaml !!!

# Postgres
INTERVIEW_POSTGRES_DSN=postgres://interview:interview@localhost:5432/interview?sslmode=disable

# Redis
INTERVIEW_REDIS_ADDR=localhost:6379
INTERVIEW_REDIS_PASSWORD=

# LLM（real 模式必须填）
INTERVIEW_LLM_MODE=mock
INTERVIEW_LLM_API_KEY=

# Embedding
INTERVIEW_EMBEDDING_MODE=mock
INTERVIEW_EMBEDDING_API_KEY=

# 部署多实例时切到 redis_lua
INTERVIEW_RATELIMIT_BACKEND=local
