# Copy to .env for docker compose local runs. Do not commit real secrets.

# Host ports
COMPOSE_INTERVIEW_APP_PORT=8080
COMPOSE_INTERVIEW_CLUSTER_PORT=18080
COMPOSE_BGE_PORT=8000

# Default compose mode is safe for local demo.
COMPOSE_INTERVIEW_LLM_MODE=mock
COMPOSE_INTERVIEW_EMBEDDING_MODE=mock
COMPOSE_INTERVIEW_RATELIMIT_BACKEND=redis_lua

# Real LLM mode. Leave empty in mock mode.
COMPOSE_INTERVIEW_LLM_BASE_URL=
COMPOSE_INTERVIEW_LLM_API_KEY=

# Real embedding mode. For local BGE, set:
# COMPOSE_INTERVIEW_EMBEDDING_MODE=real
# COMPOSE_INTERVIEW_EMBEDDING_BASE_URL=http://bge:8000/v1
# COMPOSE_INTERVIEW_EMBEDDING_MODEL=BAAI/bge-m3
# COMPOSE_INTERVIEW_EMBEDDING_DIMENSION=1024
COMPOSE_INTERVIEW_EMBEDDING_API_KEY=
COMPOSE_INTERVIEW_EMBEDDING_BASE_URL=
COMPOSE_INTERVIEW_EMBEDDING_MODEL=text-embedding-v4
COMPOSE_INTERVIEW_EMBEDDING_DIMENSION=1024
